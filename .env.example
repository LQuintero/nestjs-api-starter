NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_api_starter?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

THROTTLE_TTL=60
THROTTLE_LIMIT=100

IDEMPOTENCY_TTL_SECONDS=86400

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-password
SEED_ADMIN_NAME=Admin

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
